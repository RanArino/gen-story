{
  "schema": "film.capability-manifest@1",
  "id": "film.motion.parallax-cards",
  "version": "1.0.0",
  "kind": "motion",
  "level": 1,
  "title": "Parallax cards",
  "description": "Cards and backdrop drift at different speeds.",
