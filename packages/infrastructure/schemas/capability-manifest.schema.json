{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-spike:capability-manifest",
  "title": "Capability Manifest: the non-executable public contract of one exact Capability version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "kind",
    "level",
    "title",
    "description",
    "tags",
    "rendererApi",
    "layer",
    "media",
    "profiles",
    "aspectRatios",
    "analysis",
    "params",
    "requires",
    "incompatibleWith",
    "determinism",
    "motionLevel",
    "budgets",
    "reducedMotion",
    "fallback",
    "timing",
    "assets",
    "fixtures",
    "permissions",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "film.capability-manifest@1" },
    "id": { "$ref": "urn:film-spike:common#/$defs/capabilityId" },
    "version": { "$ref": "urn:film-spike:common#/$defs/semver" },
    "kind": { "$ref": "urn:film-spike:common#/$defs/capabilityKind" },
    "level": { "enum": [0, 1] },
    "title": { "$ref": "urn:film-spike:common#/$defs/name" },
    "description": { "$ref": "urn:film-spike:common#/$defs/plainText" },
    "tags": {
      "type": "array",
      "items": { "$ref": "urn:film-spike:common#/$defs/token" },
      "uniqueItems": true
    },
    "rendererApi": { "const": "film-capability@1" },
    "layer": { "type": "integer", "minimum": 0, "maximum": 100 },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "min", "max"],
      "properties": {
        "types": { "type": "array", "items": { "const": "image" } },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:film-spike:common#/$defs/profileId" }
    },
    "aspectRatios": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["16:9", "9:16", "1:1"] }
    },
    "analysis": { "type": "array", "items": { "const": "subjectBounds" } },
    "params": {
      "type": "object",
      "propertyNames": { "$ref": "urn:film-spike:common#/$defs/paramName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "default", "scope", "authority", "description"],
        "properties": {
          "type": { "enum": ["number", "integer", "boolean", "enum"] },
          "default": { "$ref": "urn:film-spike:common#/$defs/paramValue" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "values": {
            "type": "array",
            "items": { "$ref": "urn:film-spike:common#/$defs/token" }
          },
          "unit": { "$ref": "urn:film-spike:common#/$defs/token" },
          "scope": { "enum": ["project", "chapter", "scene"] },
          "authority": {
            "enum": ["user-exposable", "agent-settable", "compiler-only"]
          },
          "description": { "$ref": "urn:film-spike:common#/$defs/plainText" }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": { "$ref": "urn:film-spike:common#/$defs/capabilityId" }
    },
    "incompatibleWith": {
      "type": "array",
      "items": { "$ref": "urn:film-spike:common#/$defs/capabilityId" }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeded"],
      "properties": { "seeded": { "type": "boolean" } }
    },
    "motionLevel": { "enum": ["none", "subtle", "moderate", "high"] },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPrimitives", "maxKeyframes", "maxAudioEvents"],
      "properties": {
        "maxPrimitives": { "type": "integer", "minimum": 0, "maximum": 512 },
        "maxKeyframes": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "maxAudioEvents": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "reducedMotion": { "enum": ["same", "reduce", "fallback"] },
    "fallback": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "urn:film-spike:common#/$defs/capabilityId" },
            "version": { "$ref": "urn:film-spike:common#/$defs/semver" }
          }
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlapMs": { "$ref": "urn:film-spike:common#/$defs/ms" },
        "gapMs": { "$ref": "urn:film-spike:common#/$defs/ms" },
        "titleMs": { "$ref": "urn:film-spike:common#/$defs/ms" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "media"],
        "properties": {
          "name": { "$ref": "urn:film-spike:common#/$defs/slug" },
          "media": { "$ref": "urn:film-spike:common#/$defs/mediaAsset" }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourceAspect", "caption"],
        "properties": {
          "name": { "$ref": "urn:film-spike:common#/$defs/slug" },
          "sourceAspect": {
            "enum": ["16:9", "1:1", "3:2", "2:3", "4:5", "21:9"]
          },
          "caption": { "enum": ["ja", "en", "empty"] }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "network",
          "filesystem",
          "environment",
          "child-process",
          "dynamic-code",
          "clock",
          "randomness"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "source", "license"],
      "properties": {
        "author": { "$ref": "urn:film-spike:common#/$defs/name" },
        "source": { "$ref": "urn:film-spike:common#/$defs/name" },
        "license": { "$ref": "urn:film-spike:common#/$defs/token" }
      }
    }
  }
}
