{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-spike:approval-record",
  "title": "Approval Record: a digest-bound operator approval created only by the interactive CLI",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "targetDigest",
    "subject",
    "operator",
    "confirmation",
    "createdAt"
  ],
  "properties": {
    "schema": { "const": "film.approval-record@1" },
    "id": { "type": "string", "pattern": "^appr-[0-9a-f]{12}$" },
    "kind": {
      "enum": ["request", "execution", "promotion", "timing", "concat"]
    },
    "targetDigest": { "$ref": "urn:film-spike:common#/$defs/digest" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "operator": { "$ref": "urn:film-spike:common#/$defs/name" },
    "confirmation": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "createdAt": { "$ref": "urn:film-spike:common#/$defs/timestamp" }
  }
}
