{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-spike:film-style-recipe",
  "title": "Film Style Recipe: flat, code-free, immutable selection of exact registered Capabilities and assets",
  "description": "Structurally forbids code, CSS, shaders, prompts, commands, modules, paths, URLs, floating versions, extends chains, and font-family strings: every property is closed, every reference is an exact {id, version, digest} object, and every free string is either a token or plain text without URL, path, or markup characters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "title",
    "description",
    "scope",
    "owner",
    "lineage",
    "capabilities",
    "effects",
    "params",
    "fonts",
    "palette",
    "curves",
    "timing",
    "chapterAllowlist",
    "output"
  ],
  "properties": {
    "schema": { "const": "film.film-style-recipe@1" },
    "id": { "$ref": "urn:film-spike:common#/$defs/recipeId" },
    "revision": { "$ref": "urn:film-spike:common#/$defs/recipeRevision" },
    "title": { "$ref": "urn:film-spike:common#/$defs/name" },
    "description": {
      "allOf": [
        { "$ref": "urn:film-spike:common#/$defs/plainText" },
        { "maxLength": 500 }
      ]
    },
    "scope": { "enum": ["system", "organization"] },
    "owner": { "$ref": "urn:film-spike:common#/$defs/slug" },
    "lineage": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["forkedFrom"],
          "properties": {
            "forkedFrom": {
              "$ref": "urn:film-spike:common#/$defs/recipeRevisionRef"
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "ref"],
        "properties": {
          "slot": { "$ref": "urn:film-spike:common#/$defs/requiredSlot" },
          "ref": { "$ref": "urn:film-spike:common#/$defs/capabilityRef" }
        }
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "urn:film-spike:common#/$defs/capabilityRef" }
    },
    "params": {
      "type": "object",
      "propertyNames": { "$ref": "urn:film-spike:common#/$defs/capabilityId" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "urn:film-spike:common#/$defs/paramName" },
        "additionalProperties": {
          "$ref": "urn:film-spike:common#/$defs/paramValue"
        }
      }
    },
    "fonts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "ref"],
        "properties": {
          "role": { "enum": ["caption", "title"] },
          "ref": { "$ref": "urn:film-spike:common#/$defs/fontRef" }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "background", "text", "accent", "scrim"],
      "properties": {
        "family": { "$ref": "urn:film-spike:common#/$defs/token" },
        "background": { "$ref": "urn:film-spike:common#/$defs/color" },
        "text": { "$ref": "urn:film-spike:common#/$defs/color" },
        "accent": { "$ref": "urn:film-spike:common#/$defs/color" },
        "scrim": { "$ref": "urn:film-spike:common#/$defs/color" }
      }
    },
    "curves": { "$ref": "urn:film-spike:common#/$defs/curves" },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredSceneMs",
        "minSceneMs",
        "maxSceneMs",
        "minHoldMs",
        "beatQuantized"
      ],
      "properties": {
        "preferredSceneMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000
        },
        "minSceneMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "maxSceneMs": { "type": "integer", "minimum": 500, "maximum": 120000 },
        "minHoldMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "beatQuantized": { "type": "boolean" }
      }
    },
    "chapterAllowlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "min", "max"],
        "properties": {
          "field": { "$ref": "urn:film-spike:common#/$defs/chapterField" },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "urn:film-spike:common#/$defs/profileId" }
      }
    }
  }
}
