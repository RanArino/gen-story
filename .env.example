API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
GEN_STORY_SQLITE_PATH=data/gen-story.sqlite
# GEMINI_API_KEY is required for photo-aware AI: project photo analysis,
# per-scene AI fill, and complement-scene proposals. Without it those
# features throw a clear runtime error (other features still work).
GEMINI_API_KEY=
GEMINI_PHOTO_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_SCENE_FILL_MODEL=gemini-2.5-flash
GEMINI_COMPLEMENT_SCENE_MODEL=gemini-2.5-flash
# OPENAI_API_KEY powers image generation (the default provider) and is also
# required to (re)generate the style-preset preview images via
# `pnpm tsx scripts/generate-style-previews.ts`.
OPENAI_API_KEY=
