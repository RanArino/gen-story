# Gen Story environment template.
#
# This is the single environment file for the whole repository. Copy it to
# `apps/api/.env`, which `apps/api/src/server.ts` loads at startup:
#
#     cp apps/api/.env.example apps/api/.env
#
# `apps/api/.env` is gitignored. Never commit it, and never put a real key here.

# ── Server ───────────────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── Web ──────────────────────────────────────────────────────────────────────
# Next.js reads env files from `apps/web/`, not from here, so this value has no
# effect in this file. The web code defaults to http://localhost:4000, which is
# correct for local development. Only if you move the API elsewhere do you need
# to set it, and then it must go in `apps/web/.env.local`.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Database ─────────────────────────────────────────────────────────────────
GEN_STORY_SQLITE_PATH=data/gen-story.sqlite

# ── Agent runtime ────────────────────────────────────────────────────────────
# Select the text/vision runtime in Settings: Claude Code (the default), Codex,
# or API (Gemini). CLI choices use the operator's subscription login. Image
# generation is not affected by this setting; its model is picked in the GUI.
# CLI runtimes (`codex`/`claude`) only run when this is `local` (the
# default). Any other value rejects a CLI runtime selection at startup;
# deployment images should not bundle the CLI binaries in the first place.
GEN_STORY_DEPLOY_TARGET=local

# ── In-app agent chat ────────────────────────────────────────────────────────
# The project chat ("AI refine") runs on the runtime selected in Settings. On
# `api` there is no CLI to talk to, so the chat panel renders a
# disabled state with a visible reason instead of failing on Send. The model
# is optional — unset uses the CLI's own default. GEN_STORY_API_BASE_URL is
# the URL the spawned CLI session uses to reach this API's project-scoped MCP
# endpoint; the default is right for local development.
# GEN_STORY_AGENT_CHAT_MODEL=
# GEN_STORY_API_BASE_URL=http://127.0.0.1:4000

# ── Gemini ───────────────────────────────────────────────────────────────────
# Required for photo-aware AI: project photo analysis, story setup, per-scene
# AI fill, and complement-scene proposals. Also powers image generation with
# Nano Banana 2 (`gemini-3.1-flash-image`), the default image model selected
# on the Generate screen; without it that model returns mock placeholders.
#
# Without it, scene AI fill and complement-scene proposals fail with a clear
# error, while photo analysis and story setup silently fall back to
# deterministic local stubs that do not call any model (their results are
# stored with `model = local-deterministic`, which is how you can tell).
GEMINI_API_KEY=
GEMINI_PHOTO_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_STORY_SETUP_MODEL=gemini-2.5-flash
GEMINI_SCENE_FILL_MODEL=gemini-2.5-flash
GEMINI_COMPLEMENT_SCENE_MODEL=gemini-2.5-flash

# ── Vertex AI (image generation) ─────────────────────────────────────────────
# The Gemini API key's free tier allows zero image-generation requests, so
# Nano Banana fails with a "rate limit" error on a free key. Set
# GEMINI_USE_VERTEXAI=true to send Nano Banana image generation to Vertex AI
# instead, billed pay-as-you-go to GOOGLE_CLOUD_PROJECT. It authenticates with
# Application Default Credentials, not an API key:
#
#     gcloud services enable aiplatform.googleapis.com --project <project>
#     gcloud auth application-default login
#     gcloud auth application-default set-quota-project <project>
#
# Only image generation moves to Vertex; photo analysis, story setup, scene
# fill and complement scenes keep using GEMINI_API_KEY.
# GEMINI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Powers image generation when GPT Image is selected on the Generate screen,
# plus character reference sheets. Without it, those use a mock adapter that
# returns placeholder images. Also required to
# (re)generate style-preset previews via
# `pnpm tsx scripts/generate-style-previews.ts`.
OPENAI_API_KEY=
# Image requests are conservatively paced at one start every 12 seconds.
# Change this only after confirming the limits for your organization and model.
OPENAI_IMAGE_GENERATION_INTERVAL_MS=12000
