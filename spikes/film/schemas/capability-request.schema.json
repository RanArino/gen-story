{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-spike:capability-request",
  "title": "Capability Request: the approved requirement that must exist before candidate code is written",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "problem", "kind", "proposed", "catalogSearch", "requester", "acceptance"],
  "properties": {
    "schema": { "const": "film.capability-request@1" },
    "id": { "$ref": "urn:film-spike:common#/$defs/slug" },
    "title": { "$ref": "urn:film-spike:common#/$defs/name" },
    "problem": { "$ref": "urn:film-spike:common#/$defs/plainText" },
    "kind": { "$ref": "urn:film-spike:common#/$defs/capabilityKind" },
    "proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "urn:film-spike:common#/$defs/capabilityId" },
        "version": { "$ref": "urn:film-spike:common#/$defs/semver" }
      }
    },
    "catalogSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "whyNotRecipe"],
      "properties": {
        "queries": { "type": "array", "minItems": 1, "items": { "$ref": "urn:film-spike:common#/$defs/plainText" } },
        "whyNotRecipe": { "allOf": [{ "$ref": "urn:film-spike:common#/$defs/plainText" }, { "minLength": 1 }] }
      }
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": { "kind": { "enum": ["user", "agent"] }, "name": { "$ref": "urn:film-spike:common#/$defs/name" } }
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "$ref": "urn:film-spike:common#/$defs/plainText" } }
  }
}
