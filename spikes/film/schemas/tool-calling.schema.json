{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-spike:tool-calling",
  "title": "Tool Calling DTOs: one request schema per authoring-service operation; every response is a Result Envelope. No approval operation exists.",
  "x-operations": [
    "catalog.search",
    "catalog.inspect",
    "validate",
    "preflight",
    "compile",
    "recipe.fork",
    "candidate.scaffold",
    "candidate.staticCheck",
    "candidate.run",
    "candidate.evidence",
    "font.quarantine",
    "font.inspect",
    "font.promote",
    "font.deactivate",
    "registry.promote",
    "registry.activate",
    "registry.deactivate",
    "registry.rollback",
    "registry.deprecate",
    "registry.verify",
    "replay",
    "render.chapter",
    "render.concat",
    "contactSheet",
    "review.record",
    "candidate.compile",
    "candidate.promotionTarget",
    "font.promotionTarget",
    "compileConcat",
    "concatPlan",
    "grammar"
  ],
  "$defs": {
    "catalog_search.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "kind": {
          "$ref": "urn:film-spike:common#/$defs/capabilityKind"
        }
      },
      "description": "Search promoted, active registry entries. Never lists quarantined candidates."
    },
    "catalog_search.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "catalog_inspect.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "urn:film-spike:common#/$defs/semver"
        }
      },
      "description": "Inspect one exact registry entry and its Manifest."
    },
    "catalog_inspect.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "validate.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "document"
      ],
      "properties": {
        "kind": {
          "enum": [
            "story-graph",
            "chapters",
            "capability-request",
            "capability-manifest",
            "film-style-recipe",
            "font-asset-manifest",
            "film-treatment",
            "cut",
            "registry-record",
            "approval-record",
            "review-record",
            "validation-report",
            "timing-proposal",
            "resolved-render-plan",
            "concat-plan",
            "chapter-artifact",
            "result-envelope"
          ]
        },
        "document": {
          "type": "object"
        }
      },
      "description": "Validate a document against its canonical schema and semantic rules."
    },
    "validate.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "preflight.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "chapters"
      ],
      "properties": {
        "treatment": {
          "$ref": "urn:film-spike:film-treatment"
        },
        "chapters": {
          "$ref": "urn:film-spike:chapters"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "forceLevel0": {
              "type": "boolean"
            },
            "reducedMotion": {
              "type": "boolean"
            }
          }
        }
      },
      "description": "Check Chapter timing feasibility before resolution."
    },
    "preflight.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "compile.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "chapters"
      ],
      "properties": {
        "treatment": {
          "$ref": "urn:film-spike:film-treatment"
        },
        "chapters": {
          "$ref": "urn:film-spike:chapters"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "forceLevel0": {
              "type": "boolean"
            },
            "reducedMotion": {
              "type": "boolean"
            }
          }
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "outName": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        }
      },
      "description": "Compile one Resolved Render Plan per Chapter and a timing proposal."
    },
    "compile.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "recipe_fork.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "id"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          }
        },
        "id": {
          "$ref": "urn:film-spike:common#/$defs/recipeId"
        },
        "revision": {
          "type": "string"
        },
        "title": {
          "$ref": "urn:film-spike:common#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layout": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            },
            "motion": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            },
            "transition": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            },
            "typography": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            },
            "sound": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            },
            "surface": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caption": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            },
            "title": {
              "$ref": "urn:film-spike:common#/$defs/versionRef"
            }
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "urn:film-spike:common#/$defs/versionRef"
          }
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Fork a Recipe revision; authoring writes do not require approval."
    },
    "recipe_fork.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "candidate_scaffold.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "urn:film-spike:capability-request"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Create a quarantined candidate from an approved Capability Request."
    },
    "candidate_scaffold.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "candidate_run.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Run a candidate's fixtures in the contained process."
    },
    "candidate_run.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "candidate_evidence.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Produce contact-sheet and clip evidence through the trusted painter."
    },
    "candidate_evidence.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "font_quarantine.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incoming",
        "manifest"
      ],
      "properties": {
        "incoming": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "manifest": {
          "type": "object"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Copy incoming font bytes and a draft manifest into quarantine."
    },
    "font_quarantine.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "font_inspect.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Inspect a quarantined font in the contained process."
    },
    "font_inspect.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "font_promote.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Promote an inspected font into the registry."
    },
    "font_promote.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "font_deactivate.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "urn:film-spike:common#/$defs/semver"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Stop offering a font for new work; pinned references still resolve."
    },
    "font_deactivate.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "registry_promote.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Promote a reviewed candidate Capability."
    },
    "registry_promote.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "registry_activate.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "urn:film-spike:common#/$defs/semver"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Offer an exact version for new work."
    },
    "registry_activate.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "registry_deactivate.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "urn:film-spike:common#/$defs/semver"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Stop offering an exact version for new work."
    },
    "registry_deactivate.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "registry_rollback.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Restore the previously active version for new work."
    },
    "registry_rollback.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "registry_deprecate.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "urn:film-spike:common#/$defs/semver"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        }
      },
      "description": "Mark an exact version deprecated."
    },
    "registry_deprecate.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "registry_verify.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {},
      "description": "Verify every record's blobs against their digests."
    },
    "registry_verify.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "replay.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planFile",
        "treatment",
        "chapters"
      ],
      "properties": {
        "planFile": {
          "type": "string"
        },
        "treatment": {
          "$ref": "urn:film-spike:film-treatment"
        },
        "chapters": {
          "$ref": "urn:film-spike:chapters"
        }
      },
      "description": "Recompile a pinned Chapter Plan and compare its digest without rendering."
    },
    "replay.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "render_chapter.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planFile"
      ],
      "properties": {
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        },
        "planFile": {
          "type": "string"
        },
        "bypassCache": {
          "type": "boolean"
        },
        "outName": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        }
      },
      "description": "Render and verify one Chapter MP4 from an approved Plan."
    },
    "render_chapter.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "render_concat.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planFile"
      ],
      "properties": {
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "approvalId": {
          "type": "string",
          "pattern": "^appr-[0-9a-f]{12}$"
        },
        "planFile": {
          "type": "string"
        },
        "outName": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        }
      },
      "description": "Assemble the concatenated MP4 from cached Chapter artifacts."
    },
    "render_concat.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "review_record.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectDigest",
        "subject",
        "reviewer",
        "verdict",
        "notes"
      ],
      "properties": {
        "subjectDigest": {
          "$ref": "urn:film-spike:common#/$defs/digest"
        },
        "subject": {
          "type": "string"
        },
        "reviewer": {
          "$ref": "urn:film-spike:common#/$defs/name"
        },
        "verdict": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "notes": {
          "$ref": "urn:film-spike:common#/$defs/plainText"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Record an independent review. This is not an approval."
    },
    "review_record.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "candidate_static_check.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Parse and check a candidate without importing it."
    },
    "candidate_static_check.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "contact_sheet.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planFile"
      ],
      "properties": {
        "planFile": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        },
        "grayscale": {
          "type": "boolean"
        }
      },
      "description": "Write a 12-frame contact sheet for a Plan."
    },
    "contact_sheet.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "candidate_compile.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate",
        "treatment",
        "chapters"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        },
        "treatment": {
          "$ref": "urn:film-spike:film-treatment"
        },
        "chapters": {
          "$ref": "urn:film-spike:chapters"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Check candidate compatibility and compile safety fallbacks without running candidate code."
    },
    "candidate_compile.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "candidate_promotion_target.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        }
      },
      "description": "Read the digest requiring independent review and promotion approval."
    },
    "candidate_promotion_target.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "font_promotion_target.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate"
      ],
      "properties": {
        "candidate": {
          "$ref": "urn:film-spike:common#/$defs/slug"
        }
      },
      "description": "Read the inspected font promotion target."
    },
    "font_promotion_target.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "compile_concat.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "plansDir"
      ],
      "properties": {
        "treatment": {
          "$ref": "urn:film-spike:film-treatment"
        },
        "plansDir": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Compile the concatenation Plan from cached Chapter artifacts."
    },
    "compile_concat.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "concat_plan.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "artifacts"
      ],
      "properties": {
        "treatment": {
          "$ref": "urn:film-spike:film-treatment"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "plan",
              "artifact"
            ],
            "properties": {
              "plan": {
                "$ref": "urn:film-spike:resolved-render-plan"
              },
              "artifact": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "files"
                ],
                "properties": {
                  "files": {
                    "$ref": "urn:film-spike:chapter-artifact#/properties/files"
                  }
                }
              }
            }
          }
        }
      },
      "description": "Build a concatenation Plan from supplied Chapter Plans and artifact metadata."
    },
    "concat_plan.response": {
      "$ref": "urn:film-spike:result-envelope"
    },
    "grammar.request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plansDirs"
      ],
      "properties": {
        "plansDirs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Read editing-grammar metrics from Chapter Plan directories."
    },
    "grammar.response": {
      "$ref": "urn:film-spike:result-envelope"
    }
  }
}
